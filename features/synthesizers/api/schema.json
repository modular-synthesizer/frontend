{
  "openapi": "3.1.2",
  "info": {
    "version": "1.0.0",
    "title": "Synthesizers API OpenAPI specifications"
  },
  "paths": {
    "/synthesizers": {
      "post": {
        "summary": "Creates a new synthesizer from its name and number of polyphony voices",
        "operationId": "create.synthesizer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/synthesizer"
              }
            }
          }
        }
      }
    },
    "/synthesizers/{uuid}": {
      "parameters": [
        {
          "name": "uuid",
          "in": "path",
          "required": true,
          "description": "The UUID of the synthesizer to edit",
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "put": {
        "summary": "Edits a synthesizer's position and zoome level",
        "operationId": "edit.synthesizer",
        
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "The X coordinate for the synthesizer"
                  },
                  "y": {
                    "type": "number",
                    "description": "The Y Coordinate for the synthesizer"
                  },
                  "scale": {
                    "type": "number",
                    "description": "The zoom level for the synthesizer"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "synthesizer": {
        "properties": {
          "name": {
            "description": "Simple representation of a synthesizer",
            "type": "string"
          }
        }
      }
    }
  }
}