{
  "openapi": "3.1.2",
  "info": {
    "version": "1.0.0",
    "title": "Synthesizers API OpenAPI specifications"
  },
  "paths": {
    "/synthesizers": {
      "post": {
        "summary": "Creates a new synthesizer from its name and number of polyphony voices",
        "operationId": "create.synthesizer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/synthesizer"
              }
            }
          }
        }
      }
    },
    "/synthesizers/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The ObjectId of the synthesizer to edit",
          "schema": {
            "$ref": "#/components/schemas/objectId"
          }
        }
      ],
      "put": {
        "summary": "Edits a synthesizer's position and zoom level",
        "operationId": "edit.synthesizer",
        
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "The X coordinate for the synthesizer"
                  },
                  "y": {
                    "type": "number",
                    "description": "The Y Coordinate for the synthesizer"
                  },
                  "scale": {
                    "type": "number",
                    "description": "The zoom level for the synthesizer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/parameters/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The ObjectId of the parameter to edit",
          "schema": {
            "$ref": "#/components/schemas/objectId"
          }
        }
      ],
      "put": {
        "summary": "Edits a parameter's value",
        "operationId": "edit.parameter",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [ "module_id", "value", "t" ],
                "properties": {
                  "module_id": {
                    "$ref": "#/components/schemas/objectId",
                    "description": "The ObjectId of the module containing the parameter to edit."
                  },
                  "value": {
                    "type": "number",
                    "description": "The new value to attribute to the parameter."
                  },
                  "t": {
                    "type": "integer",
                    "description": "The UNIX timestamp (in milliseconds) of the edition operation, used to never apply overwritten updates."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "synthesizer": {
        "properties": {
          "name": {
            "description": "Simple representation of a synthesizer",
            "type": "string"
          }
        }
      },
      "objectId": {
        "type": "string",
        "pattern": "^[0-9a-f]{24}$",
        "description": "An ObjectId: 24 lowercase hexadecimal characters."
      }
    }
  }
}